              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>		
            <field>
              <name>AUTOEN3</name>
              <description>The status bit of channel 3 is automatically updated, when the receiver writes IPC _STS when 1,
			  the IPC_ENA is automatically updated to the same value, and when the receiver writes IPC_SET to the IPC_STS, 
			  the corresponding position bit is IPC_ENA when the receiver writes to the IPC_STS</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
