                <bitWidth>1</bitWidth>
                <access>read-only</access>
              </field>
              <field>
                <name>MID</name>
                <description>message identifier/counter of a given frame (when the I3C is acting as master)</description>
                <bitOffset>24</bitOffset>
                <bitWidth>8</bitWidth>
                <access>read-only</access>
              </field>
            </fields>
          </register>
