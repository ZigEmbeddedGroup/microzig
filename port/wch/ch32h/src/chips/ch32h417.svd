        <register>
          <name>EPR</name>
          <displayName>EPR</displayName>
          <description>PFIC Event Suspend Register</description>
          <addressOffset>0xC84</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>EVENT_PEND31_8</name>
              <description>31-8 event is suspended, write 1 to clear zero</description>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
              <access>read-write</access>
            </field>		
            <field>
              <name>EVENT_PEND7_0</name>
              <description>7-0 Event Pending Status, Not Clearable</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>		
          </fields>
        </register>
        <register>
          <name>EWUPR</name>
          <displayName>EWUPR</displayName>
          <description>PFIC Event Wake Register</description>
          <addressOffset>0xC88</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>EVENT_WUP</name>
              <description>31-0 Event Wake Register</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>				
          </fields>
        </register>
		<register>
          <name>SCTLR</name>
          <displayName>SCTLR</displayName>
          <description>System Control Register</description>
          <addressOffset>0xD10</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>SLEEPONEXIT</name>
              <description>system leaves the state after an interruption</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
			 <field>
              <name>SLEEPDEEP</name>
              <description>low power mode selection</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
			 <field>
              <name>WFITOWFE</name>
              <description>ues WFI as WFE</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
		  <field>
              <name>SEVONPEND</name>
