              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>				
            <field>
              <name>RESET_PHY</name>
              <description>SERDES Physical Layer Software Reset Control Bits</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>				
            <field>
              <name>RESET_LINK</name>
              <description>SERDES Link Layer Software Reset Control Bits</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>			
            <field>
              <name>CLR_ALL</name>
              <description>Clear the SERDES interrupt flag and FIFO</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>				
          </fields>
        </register>		
        <register>
