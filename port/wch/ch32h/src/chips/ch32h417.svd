          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>match_PID</name>
              <description>It is used to match the unlocked PID value and compare it with the PID value of each locked channel</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>write-only</access>
            </field>		
            <field>
              <name>match_CID</name>
