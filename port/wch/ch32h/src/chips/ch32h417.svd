              <field>
                <name>MIPIMID</name>
                <description>15-bit MIPI manufacturer ID</description>
                <bitOffset>17</bitOffset>
                <bitWidth>15</bitWidth>
                <access>read-only</access>
              </field>
            </fields>
          </register>
