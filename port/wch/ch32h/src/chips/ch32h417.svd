					<name>UEP5_TX_CHAIN_LEN</name>
					<description>Endpoint 5 CHAIN sends the last packet length</description>
					<addressOffset>0x146</addressOffset>
					<size>0x10</size>
					<resetValue>0x00</resetValue>
