					<name>UEP5_RX_CHAIN_NUMP</name>
					<description>Number of NUMPs has been received by Endpoint 5</description>
					<addressOffset>0x159</addressOffset>
					<size>0x8</size>
					<resetValue>0x00</resetValue>
					<fields>
						<field>
							<name>TX_CHAIN_NUMP</name>
							<description>The number of DPP packets that has received</description>
							<bitRange>[7:0]</bitRange>
							<access>read-only</access>
						</field>										
					</fields>
				</register>
