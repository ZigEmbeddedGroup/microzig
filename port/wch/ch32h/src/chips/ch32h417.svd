			  the corresponding channel interrupt status bit is automatically cleared.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>		
            <field>
              <name>KEY_VALUE</name>
              <description>Unlock keywords, which are used to match unlock method keyword comparisons.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
            </field>		
          </fields>
        </register>
      </registers>
