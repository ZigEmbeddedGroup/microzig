							<bitRange>[12:12]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>LINK_IF_TXEQ</name>
							<description>LINK enters TXEQ state interrupt flag:
								INDICATE THAT THE POLLING HANDSHAKE IS COMPLETE, 
								AND WAIT FOR THE SOFTWARE TO SET THE PWR_MODE TO P0 IN ORDER TO ENTER THE TXEQ PHASE.</description>
							<bitRange>[11:11]</bitRange>
							<access>read-write</access>
						</field>
						<field>
							<name>LINK_IF_TERM_PRES</name>
							<description>The TERM disconnected or disconnected flag was detected</description>
							<bitRange>[10:10]</bitRange>
							<access>read-write</access>
						</field>	
						<field>
							<name>LINK_IF_UX_REJ</name>
							<description>LINK refuses to enter the low-power mode (U1/U2) interrupt flag. </description>
							<bitRange>[9:9]</bitRange>
							<access>read-write</access>
						</field>					
						<field>
							<name>LINK_IF_U3_WK_TOUT</name>
