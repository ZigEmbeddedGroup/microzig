              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
			<field>
              <name>SETEVENT</name>
              <description>set event</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
			<field>
              <name>HART_ID</name>
              <description>Kernel ID register,
			  which is used to obtain the kernel ID of the reader register</description>
