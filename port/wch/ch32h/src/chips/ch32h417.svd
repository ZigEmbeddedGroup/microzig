              <field>
                <name>XDCNT</name>
                <description>data counter</description>
                <bitOffset>0</bitOffset>
                <bitWidth>16</bitWidth>
                <access>read-only</access>
              </field>
              <field>
                <name>ABT</name>
                <description>a private read message is completed/aborted prematurely by the slave (when the I3C is acting as master)</description>
                <bitOffset>17</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-only</access>
              </field>
              <field>
                <name>DIR</name>
                <description>message direction(whatever I3C is acting as master/slave)</description>
