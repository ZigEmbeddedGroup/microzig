              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>		
            <field>
              <name>RX_IER0</name>
              <description>Channel 0 receiver interrupt is enabled, and channel 0 can generate a receive interrupt when 1 is set</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>AUTOEN0</name>
              <description>The channel 0 status bit enables automatic updates</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>		
            <field>
              <name>LOCK0</name>
