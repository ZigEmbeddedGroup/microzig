              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
            <field>
              <name>TX_CID3</name>
              <description>The ID of the sender kernel and the kernel that responds to the send interrupt</description>
